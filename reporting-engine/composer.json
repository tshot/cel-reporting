{
  "name": "cel/reporting-engine",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "cel/shared-lib": "*",
    "cel/project-emollient": "*"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../shared-lib"
    },
    {
      "type": "path",
      "url": "../projects/Emollient"
    }
  ],
  "autoload": {
    "psr-4": {
      "CEL\\Reporting\\": ""
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
